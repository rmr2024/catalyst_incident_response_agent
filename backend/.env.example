DATABASE_URL=sqlite:///./incidents.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8501
MEMORY_ENABLED=true
CRITICAL_SERVICES=payments,checkout,auth,api-gateway

# --- LLM Provider ---
# Options: claude | groq | mock  (use "mock" for local dev without an API key)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Hindsight Long-Term Memory ---
# When unreachable the agent falls back to the in-process mock store.
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK=incidents

# --- P1: Novel Incident Detection ---
# Minimum similarity score (0.0-1.0) for a memory hit to be considered relevant.
# Hits below this threshold → novel_incident=true
NOVEL_THRESHOLD=0.25

# --- P3 Data / Scenarios (optional override) ---
# DATA_DIR=../data
