# ============================================================
# Incident Response Agent – Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.

# --- Database ---
DATABASE_URL=sqlite:///./incidents.db

# --- Frontend ---
CORS_ORIGINS=http://localhost:8501

# --- Agent Behaviour ---
# Services considered critical (P1 classification)
CRITICAL_SERVICES=payments,checkout,auth,api-gateway

# --- Memory Feature Flag ---
# Set to true to enable Hindsight long-term memory recall/retention.
# Set to false to run the agent using only current incident context.
MEMORY_ENABLED=true

# --- Novel Incident Detection ---
# Minimum similarity score (0.0-1.0) for a memory hit to be considered relevant.
# Hits below this threshold → novel_incident=true
NOVEL_THRESHOLD=0.25

# --- LLM Provider ---
# Options: claude | groq | mock
# Use "mock" for local development without any API key.
LLM_PROVIDER=mock
LLM_MODEL=

# --- Anthropic Claude ---
# Required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# --- Groq ---
# Required when LLM_PROVIDER=groq
GROQ_API_KEY=

# --- Hindsight Long-Term Memory ---
# Set HINDSIGHT_URL to your Hindsight instance URL.
# Leave HINDSIGHT_API_KEY blank if no auth is required.
# When Hindsight is unreachable, the agent falls back to the in-process mock store.
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK=incidents
